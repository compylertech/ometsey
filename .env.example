# The admin (/admin) signs in against the project-x backend. Copy to .env.local to override.
#
# Tenant sent as X-Tenant-Id on every call. Defaults to "ometsey".
VITE_TENANT_ID=ometsey
#
# Backend base URL. Left unset, development uses the Vite proxy (/api -> http://localhost:8083)
# and builds use https://projectx-api-prod.compyler.io. The backend only allows a fixed list of
# browser origins, so a deployed site's origin must be added to its allowed-origins first.
# VITE_API_BASE_URL=
#
# Where the dev proxy forwards /api. Defaults to http://localhost:8083.
# VITE_DEV_API_TARGET=
